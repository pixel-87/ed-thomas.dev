---
const currentYear = new Date().getFullYear();

interface SocialLink {
  href: string;
  label: string;
  icon?: string;
  paths?: string[];
}

const socials: SocialLink[] = [
  {
    href: "https://github.com/pixel-87",
    label: "GitHub",
    icon: "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
  },
  {
    href: "https://www.linkedin.com/in/edthomas87",
    label: "LinkedIn",
    paths: [
      "M8 11v5",
      "M8 8v.01",
      "M12 16v-5",
      "M16 16v-3a2 2 0 1 0 -4 0",
      "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
    ],
  },
  {
    href: "https://hachyderm.io/@EdThomas",
    label: "Mastodon",
    paths: [
      "M18.648 15.254c-1.816 1.763 -6.648 1.626 -6.648 1.626a18.262 18.262 0 0 1 -3.288 -.256c1.127 1.985 4.12 2.81 8.982 2.475c-1.945 2.013 -13.598 5.257 -13.668 -7.636l-.026 -1.154c0 -3.036 .023 -4.115 1.352 -5.633c1.671 -1.91 6.648 -1.666 6.648 -1.666s4.977 -.243 6.648 1.667c1.329 1.518 1.352 2.597 1.352 5.633s-.456 4.074 -1.352 4.944z",
      "M12 11.204v-2.926c0 -1.258 -.895 -2.278 -2 -2.278s-2 1.02 -2 2.278v4.722m4 -4.722c0 -1.258 .895 -2.278 2 -2.278s2 1.02 2 2.278v4.722",
    ],
  },
  {
    href: "/rss.xml",
    label: "RSS",
    paths: [
      "M5 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
      "M4 4a16 16 0 0 1 16 16",
      "M4 11a9 9 0 0 1 9 9",
    ],
  },
];
---

<footer class="mt-16 pt-8 border-t border-gray-300/60 dark:border-gray-800/60 font-mono text-xs text-gray-700 dark:text-gray-300">
  <!-- Centered closing message -->
  <div class="text-center mb-8 text-sm sm:text-base tracking-tight text-gray-800 dark:text-gray-200">
    Thanks for visiting. Have a look around!
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Top nav links & Copyright with Github source -->
    <div class="sm:col-span-7 flex flex-col space-y-4 text-left">
      <!-- Navigation Links -->
      <nav aria-label="Footer Navigation">
        <ul class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-normal">
          <li><a href="/" class="underline-offset-4 hover:underline">Home</a></li>
          <li aria-hidden="true" class="select-none text-gray-400 dark:text-gray-600">·</li>
          <li><a href="/blog" class="underline-offset-4 hover:underline">Blog</a></li>
          <li aria-hidden="true" class="select-none text-gray-400 dark:text-gray-600">·</li>
          <li><a href="/projects" class="underline-offset-4 hover:underline">Projects</a></li>
          <li aria-hidden="true" class="select-none text-gray-400 dark:text-gray-600">·</li>
          <li><a href="/misc" class="underline-offset-4 hover:underline">Misc</a></li>
          <li aria-hidden="true" class="select-none text-gray-400 dark:text-gray-600">·</li>
          <li><a href="/cv" class="underline-offset-4 hover:underline">CV</a></li>
        </ul>
      </nav>

      <!-- Copyright & GitHub Source Link -->
      <p class="text-xs text-gray-600 dark:text-gray-400">
        © 2024–{currentYear} Ed Thomas. <a
          href="https://github.com/pixel-87/ed-thomas.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-gray-900 dark:hover:text-gray-100"
        >Source</a>.
      </p>
    </div>

    <!-- Right Column: Social Links & Webrings section header -->
    <div class="sm:col-span-5 flex flex-col space-y-6 sm:text-right sm:items-end">
      <!-- On the web -->
      <div class="w-full flex flex-col sm:items-end">
        <h3 class="italic text-xs mb-2 text-gray-600 dark:text-gray-400">On the web</h3>
        <div class="flex items-center gap-3 justify-start sm:justify-end">
          {
            socials.map((social) => (
              <a
                href={social.href}
                class="hover:text-gray-900 dark:hover:text-white transition-colors"
                aria-label={social.label}
                title={social.label}
                target={social.href.startsWith("http") ? "_blank" : undefined}
                rel={social.href.startsWith("http") ? "noopener noreferrer me" : undefined}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  {social.icon && <path d={social.icon} />}
                  {social.paths && social.paths.map((p) => <path d={p} />)}
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Webrings heading space reserved for future webrings -->
      <div class="w-full flex flex-col sm:items-end">
        <h3 class="italic text-xs mb-2 text-gray-600 dark:text-gray-400">Webrings</h3>
      </div>
      <script is:inline src="https://pixel-87.github.io/edge-ring/embed.js" data-member="ed" data-theme="dark"></script>
    </div>
  </div>
</footer>
